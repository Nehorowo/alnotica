{
  "name": "alnotica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node ops/dev.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --experimental-strip-types packages/db/src/cli/migrate.ts",
    "seed": "node --experimental-strip-types packages/db/src/cli/seed.ts",
    "set-webhook": "node --experimental-strip-types ops/set-webhook.ts"
  },
  "devDependencies": {
    "@alnotica/core": "workspace:*",
    "@alnotica/db": "workspace:*",
    "@alnotica/shared": "workspace:*",
    "@biomejs/biome": "^1.9.4",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^30.0.1",
    "luxon": "^3.5.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
