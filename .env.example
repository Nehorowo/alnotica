# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every variable is validated at boot: a missing or
# malformed one takes the process down immediately with a readable message.
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
TZ=UTC

# --- database ---------------------------------------------------------------
POSTGRES_USER=alnotica
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alnotica
DATABASE_URL=postgres://alnotica:change-me@db:5432/alnotica
# Ten per process; two processes stay well under max_connections=100.
DATABASE_POOL_MAX=10

# --- telegram ---------------------------------------------------------------
# The shared bot every tenant starts on. From @BotFather.
BOT_TOKEN=123456789:AA...
BOT_USERNAME=YourBot

# Sent to Telegram with setWebhook and echoed back in the
# X-Telegram-Bot-Api-Secret-Token header. Generate with:
#   openssl rand -base64 32
WEBHOOK_SECRET=change-me-at-least-16-characters
# `on` in production, `off` for long polling in development.
WEBHOOK_MODE=on

# --- public surface ---------------------------------------------------------
DOMAIN=bot.example.com
PUBLIC_URL=https://bot.example.com
MINIAPP_DIST=apps/miniapp/dist
API_PORT=3000
API_HOST=0.0.0.0

# --- secrets ----------------------------------------------------------------
# 32 bytes, base64 or hex. Encrypts dedicated bots' tokens at rest.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-base64-or-hex

# --- legal ------------------------------------------------------------------
POLICY_URL=https://example.com/policy
OFFER_URL=https://example.com/offer
SUPPORT_USERNAME=alnotica_support

# --- admin ------------------------------------------------------------------
# Chat that receives sales leads and the moderation queue.
ADMIN_CHAT_ID=-1001234567890
# Comma-separated Telegram ids allowed to use /admin.
ADMIN_TELEGRAM_IDS=123456789

# --- alerting ---------------------------------------------------------------
# A separate bot, so a broken main bot does not also silence the alarm.
ALERTS_ENABLED=true
ALERT_TG_TOKEN=987654321:AA...
ALERT_TG_CHAT=123456789

# --- worker -----------------------------------------------------------------
WORKER_CONCURRENCY=8
WORKER_POLL_MS=1000

# --- backups ----------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
S3_BUCKET=alnotica-backups
S3_ENDPOINT=https://s3.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
